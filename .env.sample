# ── Proxy auth ────────────────────────────────────────────────────────────────
# Clients send this as x-api-key or Authorization: Bearer <key>
# Generate with: python -c "import secrets; print('sk-' + secrets.token_hex(16))"
LITELLM_MASTER_KEY=sk-replace-with-a-secure-random-key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG   # verbose — shows every retry and fallback decision

# ── Anthropic OAuth tokens ────────────────────────────────────────────────────
# Each person runs: claude setup-token  (or use the Anthropic console)
# Sub A = primary subscription, Sub B = secondary/failover subscription
SUB_A_OAUTH_TOKEN=sk-ant-oat01-replace-with-real-token
SUB_B_OAUTH_TOKEN=sk-ant-oat01-replace-with-real-token

# ── Paid API key — emergency fallback only ────────────────────────────────────
# Used when both OAuth tokens are exhausted/rate-limited
ANTHROPIC_API_KEY=sk-ant-replace-with-real-key

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Only needed when running multiple proxy instances that share health state.
# Comment out to use in-memory health tracking (single instance only).
# REDIS_HOST=localhost
# REDIS_PASSWORD=replace-with-redis-password

# ── Proxy bind (optional overrides) ──────────────────────────────────────────
# CCC_HOST=0.0.0.0
# CCC_PORT=4000
# CCC_CONFIG=config.yaml
